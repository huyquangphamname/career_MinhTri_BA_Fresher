        <mxCell id="c-sub" value="Ban Lãnh đạo cần biết chính xác giá trị TSĐB còn Tự do theo từng loại tài sản&lt;br&gt;để lập kế hoạch vay mới — không chờ Phòng Tài chính cộng tay trên Excel." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#5A6A62;" vertex="1" parent="1">

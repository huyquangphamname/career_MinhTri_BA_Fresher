  </diagram>
  <diagram id="p4" name="5. Rủi ro">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="r-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F7F2;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/>
        </mxCell>
        <mxCell id="r-title" value="3. Rủi ro khi mọi user đều Xem / Thêm / Sửa / Xóa" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Georgia;fontSize=26;fontColor=#1A2620;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="r-sub" value="Đề khóa constraint “không phân quyền”. Không phản đối suông — nhận constraint, chỉ ra lỗ hổng làm sai số Tự do trên báo cáo sếp, rồi kiểm soát trên dữ liệu." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#5A6A62;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1500" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="r-h1" value="HÀNH VI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1A2620;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=14;fontFamily=Courier New;fontSize=11;fontColor=#F5F7F2;" vertex="1" parent="1">
          <mxGeometry x="40" y="104" width="360" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="r-h2" value="SỐ TỰ DO TRÊN BÁO CÁO SẾP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1A2620;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=14;fontFamily=Courier New;fontSize=11;fontColor=#F5F7F2;" vertex="1" parent="1">
          <mxGeometry x="400" y="104" width="1160" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="r-a1" value="Xóa cứng con đang cầm cố&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;≠ Giải chấp (gỡ thế chấp, giữ vết)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6E2DA;strokeColor=#9B3418;align=left;verticalAlign=middle;spacingLeft=14;fontFamily=Helvetica;fontSize=13;fontColor=#9B3418;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="136" width="360" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="r-b1" value="Tự do cũng tăng (30→60) như giải chấp, nhưng mất dòng HĐ → không đối soát được với ngân hàng. Use case trang 2 không có Xóa." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C3CDC6;align=left;verticalAlign=middle;spacingLeft=14;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="400" y="136" width="1160" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="r-a2" value="Sửa GT cha giảm / GT con tăng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6E2DA;strokeColor=#9B3418;align=left;verticalAlign=middle;spacingLeft=14;fontFamily=Helvetica;fontSize=14;fontColor=#9B3418;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="192" width="360" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="r-b2" value="Bỏ qua cổng 3 → Tự do âm hoặc vượt sức chứa. Báo cáo không còn cộng được." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C3CDC6;align=left;verticalAlign=middle;spacingLeft=14;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="400" y="192" width="1160" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="r-a3" value="Sửa tay ô Tự do" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6E2DA;strokeColor=#9B3418;align=left;verticalAlign=middle;spacingLeft=14;fontFamily=Helvetica;fontSize=14;fontColor=#9B3418;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="248" width="360" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="r-b3" value="Mất single source of truth. Hai dashboard, hai số — đúng bệnh Excel hiện tại." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C3CDC6;align=left;verticalAlign=middle;spacingLeft=14;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="400" y="248" width="1160" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="r-a4" value="Hai người sửa cùng lúc / không nhật ký" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6E2DA;strokeColor=#9B3418;align=left;verticalAlign=middle;spacingLeft=14;fontFamily=Helvetica;fontSize=14;fontColor=#9B3418;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="304" width="360" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="r-b4" value="Cộng hai HĐ hoặc mất một HĐ. Khi sếp hỏi “số này từ đâu” không trả lời được." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C3CDC6;align=left;verticalAlign=middle;spacingLeft=14;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="400" y="304" width="1160" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="r-fixh" value="BỐN KIỂM SOÁT ĐƠN GIẢN — không cần ma trận quyền" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Georgia;fontSize=18;fontColor=#1A2620;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="384" width="900" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="r-f1" value="&lt;b&gt;1. Tự do là field tính, khóa nhập&lt;/b&gt;&lt;br&gt;Mọi màn hình và báo cáo sếp đọc cùng một công thức. Kiểm soát rẻ nhất, chặn rủi ro lớn nhất." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D7EEE3;strokeColor=#1B6A48;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontFamily=Helvetica;fontSize=13;fontColor=#1A2620;" vertex="1" parent="1">
          <mxGeometry x="40" y="424" width="370" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="r-f2" value="&lt;b&gt;2. Cấm xóa cứng bản ghi cầm cố&lt;/b&gt;&lt;br&gt;Chỉ Giải chấp / Ngưng hiệu lực, bắt buộc lý do. Dòng con còn để đối soát với ngân hàng." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B6A48;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontFamily=Helvetica;fontSize=13;fontColor=#1A2620;" vertex="1" parent="1">
          <mxGeometry x="426" y="424" width="370" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="r-f3" value="&lt;b&gt;3. Nhật ký trước–sau&lt;/b&gt;&lt;br&gt;Mọi Thêm / Sửa / Giải chấp: ai, lúc nào, GT cũ → mới, HĐ nào. Không phân quyền nhưng không ẩn danh." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B6A48;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontFamily=Helvetica;fontSize=13;fontColor=#1A2620;" vertex="1" parent="1">
          <mxGeometry x="812" y="424" width="370" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="r-f4" value="&lt;b&gt;4. Snapshot báo cáo sếp cuối ngày&lt;/b&gt;&lt;br&gt;Vận hành trong ngày không đè gói đã gửi lãnh đạo. Tuỳ chọn: maker–checker 1 bước (Kế toán trưởng duyệt)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B6A48;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontFamily=Helvetica;fontSize=13;fontColor=#1A2620;" vertex="1" parent="1">
          <mxGeometry x="1198" y="424" width="362" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="r-pin" value="Câu chốt: rủi ro không phải “ai được vào module”, mà là “số Tự do có bị viết đè không kiểm soát”." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1A2620;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=18;fontFamily=Helvetica;fontSize=16;fontColor=#F5F7F2;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="568" width="1520" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="r-q" value="&lt;b&gt;Hỏi ngược (chọn 2, rồi dừng)&lt;/b&gt;&lt;br&gt;1. Sếp nhìn Tự do theo &lt;b&gt;giá sổ&lt;/b&gt; hay &lt;b&gt;giá sau haircut từng ngân hàng&lt;/b&gt;?&lt;br&gt;2. Một tài sản cha có được cầm cố cấp 2 (second charge) không?&lt;br&gt;3. Định giá lại: khi GT cha giảm dưới Σ con đang cầm cố — chặn, hay cảnh báo + tạo việc định giá?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C3CDC6;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;fontFamily=Helvetica;fontSize=14;fontColor=#1A2620;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="1520" height="140" as="geometry"/>

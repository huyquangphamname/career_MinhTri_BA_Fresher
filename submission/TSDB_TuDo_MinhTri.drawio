        <mxCell id="f-vd" value="Lô đất 100 − VCB 40 − BIDV 30 = Tự do 30  →  giải chấp BIDV  →  Tự do 60, dòng HĐ-BIDV-002 vẫn trên sổ (đã giải chấp)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#5A6A62;" vertex="1" parent="1">
          <mxGeometry x="56" y="452" width="1100" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="f-log" value="&lt;b&gt;Nhật ký trước–sau&lt;/b&gt;&lt;br&gt;User · lúc · GT cũ → mới · HĐ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A2620;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A2620;" vertex="1" parent="1">
          <mxGeometry x="56" y="480" width="360" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="f-recalc" value="&lt;b&gt;Tính lại Tự do (ô khóa nhập)&lt;/b&gt;&lt;br&gt;GT gốc − Σ cầm cố còn hiệu lực" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D7EEE3;strokeColor=#1B6A48;strokeWidth=1.5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A2620;" vertex="1" parent="1">
          <mxGeometry x="456" y="480" width="360" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="f-rpt" value="&lt;b&gt;Snapshot báo cáo sếp&lt;/b&gt;&lt;br&gt;Chốt cuối ngày — không đè số đã gửi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1A2620;strokeColor=#1A2620;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#F5F7F2;" vertex="1" parent="1">
          <mxGeometry x="856" y="480" width="360" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="e-sua-log" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1A2620;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-sua" target="f-log">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-giai-log" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1B6A48;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-giai" target="f-log">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-ngung-log" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1A2620;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-ngung" target="f-log">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-log-re" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1A2620;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="f-log" target="f-recalc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-re-rpt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1A2620;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="f-recalc" target="f-rpt">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f-g1" value="&lt;b&gt;Cổng 1 · Cha (cổng GT)&lt;/b&gt;&lt;br&gt;GT gốc &amp;gt; 0, mã không trùng. Thiếu ngày định giá → cảnh báo, chưa chặn." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C3CDC6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A2620;" vertex="1" parent="1">
          <mxGeometry x="40" y="592" width="370" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="f-g2" value="&lt;b&gt;Cổng 2 · Đích phân bổ&lt;/b&gt;&lt;br&gt;Phân bổ cầm cố phải gắn NH + HĐ bảo đảm. Phần không phân bổ là số Tự do hệ thống tính, không tạo khoản cầm cố." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C3CDC6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A2620;" vertex="1" parent="1">
          <mxGeometry x="430" y="592" width="370" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="f-g3" value="&lt;b&gt;Cổng 3 · Sức chứa tại thời điểm giao dịch&lt;/b&gt;&lt;br&gt;Σ phân bổ còn hiệu lực ≤ GT cha. Phân bổ hết hiệu lực/lịch sử không chiếm sức chứa; vượt → chặn lưu." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C3CDC6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A2620;" vertex="1" parent="1">
          <mxGeometry x="820" y="592" width="370" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="f-g4" value="&lt;b&gt;Cổng 4 · Tính lại&lt;/b&gt;&lt;br&gt;Giải chấp tăng Tự do kèm vết. Xóa cứng tăng Tự do nhưng mất bằng chứng — cấm." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C3CDC6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=12;fontColor=#1A2620;" vertex="1" parent="1">
          <mxGeometry x="1210" y="592" width="350" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="f-pin" value="Câu chốt: BA không chỉ vẽ luồng tạo mới — luồng sửa / giải chấp mới làm sai số sếp. Cổng 4 giữ số tăng kèm vết, không tăng bằng cách xóa bằng chứng." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1A2620;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=16;fontFamily=Helvetica;fontSize=14;fontColor=#F5F7F2;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="672" width="1520" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="f-foot" value="Trang 1/5  ·  Giải chấp = gỡ thế chấp khi HĐ hết hiệu lực. Demo cổng 3 trên HTML: gán 50 tỷ vào lô đất (còn 30) → chặn." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#5A6A62;" vertex="1" parent="1">
          <mxGeometry x="40" y="852" width="1400" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="u-note1" value="&lt;b&gt;Sếp trên màn 1&lt;/b&gt;&lt;br&gt;Không nhập liệu. Ô Tự do khóa.&lt;br&gt;Câu hỏi đề: còn bao nhiêu để vay tiếp?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B6A48;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="360" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="u-note2" value="&lt;b&gt;Finance trên màn 2&lt;/b&gt;&lt;br&gt;Mở BĐS: VCB 40 · BIDV 30.&lt;br&gt;Đối soát HĐ, không cộng tay Excel." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4760;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="640" width="360" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="u-note3" value="&lt;b&gt;USER STORY · Gán phân bổ (Cổng 3)&lt;/b&gt;&lt;br&gt;Là User Vận hành, tôi muốn gán 50 tỷ vào cha 100 tỷ đang có 40 + 30, để ghi nhận HĐ mới.&lt;br&gt;&lt;b&gt;Kết quả:&lt;/b&gt; 120 &amp;gt; 100 → chặn lưu, báo vượt 20; số Tự do 30 không đổi." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B3418;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="640" width="380" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="u-note4" value="&lt;b&gt;USER STORY · Vòng đời (Cổng 4)&lt;/b&gt;&lt;br&gt;Khi B1 xác nhận giải chấp 20, User Vận hành ghi ngày hiệu lực/lý do; hệ thống chuyển Released, giữ audit và tính lại.&lt;br&gt;Sửa GT → chạy lại Cổng 3. Ngưng không giải phóng nếu còn ràng buộc. Không xóa cứng phân bổ đã dùng." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1A2620;strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontFamily=Helvetica;fontSize=11;fontColor=#F5F7F2;" vertex="1" parent="1">
          <mxGeometry x="1200" y="640" width="360" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="u-foot" value="Trang Use Case · Persona ≠ quyền. Cổng 3 ngăn over-allocation; Cổng 4 lưu lịch sử, cập nhật số theo ngày hiệu lực; xóa cứng không dùng để giải chấp." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#5A6A62;" vertex="1" parent="1">
          <mxGeometry x="40" y="852" width="1400" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p2" name="1. Màn tổng - Tự do tại thời điểm xem">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">

        <mxCell id="m-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8ECE6;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/>
        </mxCell>
        <mxCell id="m-title" value="1. Màn tổng — Tài sản Tự do tại thời điểm xem" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Georgia;fontSize=24;fontColor=#1A2620;fontStyle=1" vertex="1" parent="1">
